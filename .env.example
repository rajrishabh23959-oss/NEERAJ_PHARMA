# Neeraj Pharma Healthcare Platform - Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supports 'embedded', 'mongodb', or 'postgres')
# 'embedded' is the zero-config default using ./data/hospital_locator_db.json
DB_DIALECT=embedded
MONGODB_URI=mongodb://127.0.0.1:27017/neeraj_pharma_healthcare
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/neeraj_pharma_healthcare
DB_FILE=./data/hospital_locator_db.json

# JWT Security Configuration
JWT_SECRET=neeraj_pharma_2026_hmac_sha256_production_secret_key
JWT_EXPIRES_IN=86400

# Geolocation Search Configuration
DEFAULT_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=100
