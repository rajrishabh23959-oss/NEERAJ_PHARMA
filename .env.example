# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use a local MongoDB (e.g. mongodb://127.0.0.1:27017/neerajpharma_db)
# or MongoDB Atlas connection string.
# If left empty or 'inmemory', an in-memory MongoDB will be launched automatically!
MONGO_URI=inmemory

# JWT Authentication Secrets
# Security Note: Must be at least 32 characters long. The server fails fast on weak/placeholder secrets.
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_long_placeholder
JWT_EXPIRE=30d

# Super Admin Registration Secret
# Security Note: Must be at least 16 characters long. The server fails fast on weak/placeholder secrets.
ADMIN_SECRET=your_super_admin_registration_secret_key_placeholder

# CORS Origin
# In development/test, defaults to '*' if omitted.
# In production (NODE_ENV=production), an explicit client origin is strictly required (e.g. https://yourfrontend.com).
CLIENT_URL=http://localhost:3000

# Rate Limiting Configuration (DDoS & Brute Force Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
