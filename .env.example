# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use a local MongoDB (e.g. mongodb://127.0.0.1:27017/neerajpharma_db)
# or MongoDB Atlas connection string.
# If left empty or 'inmemory', an in-memory MongoDB will be launched automatically!
MONGO_URI=inmemory

# JWT Authentication Secrets
JWT_SECRET=neerajpharma_super_secure_jwt_secret_key_2026
JWT_EXPIRE=30d

# Super Admin Registration Secret
ADMIN_SECRET=neeraj_super_admin_secret_2026

# CORS Origin
CLIENT_URL=*

# Rate Limiting Configuration (DDoS & Brute Force Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
