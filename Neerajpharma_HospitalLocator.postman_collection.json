{
  "info": {
    "_postman_id": "neerajpharma-hospital-locator-api-2026",
    "name": "Neerajpharma | Healthcare & Emergency Hospital Locator API",
    "description": "Comprehensive Postman collection for the Neerajpharma Responsive Healthcare & Emergency HospitalLocator backend platform. Covering all 10 requirements: Schema, CRUD, Geo Search, Quick SOS, Multi-Filtering, JWT+RBAC, Admin Metrics, Validation, Security Hardening, and Documentation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "hospitalAdminToken", "value": "", "type": "string" },
    { "key": "userToken", "value": "", "type": "string" },
    { "key": "hospitalId", "value": "", "type": "string" },
    { "key": "ambulanceId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "helplineId", "value": "", "type": "string" },
    { "key": "targetUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "API Sitemap & Root",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1", "host": ["{{baseUrl}}"], "path": ["api", "v1"] }
          }
        }
      ]
    },
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.collectionVariables.set('token', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@neerajpharma.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Login Hospital Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.collectionVariables.set('hospitalAdminToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh.verma@aiims.edu\",\n  \"password\": \"HospitalAdmin123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Login Regular User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.collectionVariables.set('userToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.patel@gmail.com\",\n  \"password\": \"UserPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"phone\": \"+91 98765 43210\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Update User Profile Details",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Neeraj Sharma (Senior Director)\",\n  \"phone\": \"+91 98100 99999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/updatedetails", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "updatedetails"] }
          }
        },
        {
          "name": "Bookmark Hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/saved-hospitals/{{hospitalId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "saved-hospitals", "{{hospitalId}}"] }
          }
        },
        {
          "name": "Remove Hospital Bookmark",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/saved-hospitals/{{hospitalId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "saved-hospitals", "{{hospitalId}}"] }
          }
        }
      ]
    },
    {
      "name": "2. Hospitals & Geo Location",
      "item": [
        {
          "name": "Find Nearby Hospitals (GPS Lat/Lng)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/hospitals/nearby?lat=28.5672&lng=77.2090&radius=20&hasIcu=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hospitals", "nearby"],
              "query": [
                { "key": "lat", "value": "28.5672" },
                { "key": "lng", "value": "77.2090" },
                { "key": "radius", "value": "20" },
                { "key": "hasIcu", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Search & Multi-Filter Hospitals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/hospitals/search?q=cardio&city=Delhi&is24x7=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hospitals", "search"],
              "query": [
                { "key": "q", "value": "cardio" },
                { "key": "city", "value": "Delhi" },
                { "key": "is24x7", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get All Hospitals (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) { pm.collectionVariables.set('hospitalId', jsonData.data[0]._id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/hospitals?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hospitals"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Hospital By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "hospitals", "{{hospitalId}}"] }
          }
        },
        {
          "name": "Create Hospital",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apollo Spectra Hospitals\",\n  \"type\": \"Super-Specialty\",\n  \"latitude\": 28.5524,\n  \"longitude\": 77.2412,\n  \"contactPhone\": \"+91 11 4055 5555\",\n  \"emergencyHotline\": \"+91 11 1066\",\n  \"address\": {\n    \"street\": \"Kailash Colony\",\n    \"city\": \"New Delhi\",\n    \"state\": \"Delhi\",\n    \"postalCode\": \"110048\"\n  },\n  \"facilities\": [\"ICU\", \"CT Scan\", \"Blood Bank\"],\n  \"specialties\": [\"Cardiology\", \"Orthopedics\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/hospitals", "host": ["{{baseUrl}}"], "path": ["api", "v1", "hospitals"] }
          }
        },
        {
          "name": "Update Hospital Availability (Real-Time Beds)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availableBeds\": 75,\n  \"availableIcuBeds\": 16,\n  \"availableOxygenBeds\": 28,\n  \"isEmergencyAccepting\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}/availability", "host": ["{{baseUrl}}"], "path": ["api", "v1", "hospitals", "{{hospitalId}}", "availability"] }
          }
        },
        {
          "name": "Verify Hospital Credentials",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isVerified\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "hospitals", "{{hospitalId}}", "verify"] }
          }
        }
      ]
    },
    {
      "name": "3. Emergency & Quick SOS",
      "item": [
        {
          "name": "1-Tap Quick SOS Emergency Aggregator",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/emergency/quick-sos?lat=28.5672&lng=77.2090",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "emergency", "quick-sos"],
              "query": [
                { "key": "lat", "value": "28.5672" },
                { "key": "lng", "value": "77.2090" }
              ]
            }
          }
        },
        {
          "name": "Get Emergency Helplines",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/emergency/contacts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "emergency", "contacts"] }
          }
        },
        {
          "name": "Find Ambulances (Nearby GPS)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/emergency/ambulances?lat=28.5672&lng=77.2090&radius=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "emergency", "ambulances"],
              "query": [
                { "key": "lat", "value": "28.5672" },
                { "key": "lng", "value": "77.2090" },
                { "key": "radius", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "Update Ambulance Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"available\",\n  \"latitude\": 28.5680,\n  \"longitude\": 77.2085\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/emergency/ambulances/{{ambulanceId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "emergency", "ambulances", "{{ambulanceId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "4. Doctors Directory",
      "item": [
        {
          "name": "Get Doctors (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors?specialization=Cardiology&isEmergencyAvailable=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors"],
              "query": [
                { "key": "specialization", "value": "Cardiology" },
                { "key": "isEmergencyAvailable", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "doctors", "{{doctorId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Admin Management",
      "item": [
        {
          "name": "Get System Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/dashboard-stats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "dashboard-stats"] }
          }
        },
        {
          "name": "List All Users (Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"hospital_admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "role"] }
          }
        },
        {
          "name": "Toggle User Active Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "status"] }
          }
        }
      ]
    }
  ]
}
